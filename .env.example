# Google Apps Script API Configuration Details
# Copy this file to '.env' and fill in your credentials. Do not check '.env' into git version control.

# Google Apps Script Web App URL (deployed from Code.gs)
VITE_GAS_URL=https://script.google.com/macros/s/your-deployment-id/exec

# Event Expenses Spreadsheet ID (from Google Sheet URL)
VITE_SPREADSHEET_ID=your-spreadsheet-id-for-event-expenses

# Book Keeping Spreadsheet ID (from bookkeeping Google Sheet URL)
VITE_BOOKKEEPING_SS_ID=your-spreadsheet-id-for-book-keeping

# Secure direct SMTP mailing parameters (Gmail App Passwords)
HOST_EMAIL=admin@ieee.org
SENDER_EMAIL=your-sender-gmail-account@gmail.com
SENDER_PASSWORD=your-16-char-google-app-password

# Serverless Neon PostgreSQL Database URL (used by serverless API actions in api/auth.js)
DATABASE_URL=postgresql://neondb_owner:password@ep-host-name.pooler.region.neon.tech/neondb?sslmode=require
